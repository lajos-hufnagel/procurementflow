<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <ViewSettingsDialog id="caseSortDialog" title="{i18n>sortCasesTitle}" confirm=".onSortCasesConfirm">
    <sortItems>
      <ViewSettingsItem key="caseNumber" text="{i18n>caseNumber}"/>
      <ViewSettingsItem key="material" text="{i18n>material}"/>
      <ViewSettingsItem key="requiredOn" text="{i18n>requiredOn}"/>
      <ViewSettingsItem key="referenceDelivery" text="{i18n>referenceDelivery}"/>
      <ViewSettingsItem key="quantity" text="{i18n>quantity}"/>
      <ViewSettingsItem key="location" text="{i18n>location}"/>
      <ViewSettingsItem key="status" text="{i18n>status}"/>
      <ViewSettingsItem key="selectedSupplier" text="{i18n>selectedSupplier}"/>
    </sortItems>
  </ViewSettingsDialog>
</core:FragmentDefinition>

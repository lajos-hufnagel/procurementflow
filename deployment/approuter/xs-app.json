{
  "welcomeFile": "/cockpit/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/(procurement(?:/.*)?|app-config)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}

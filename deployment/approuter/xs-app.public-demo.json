{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/(procurement(?:/.*)?|app-config|demo/(?:session|reset|scenario))$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}

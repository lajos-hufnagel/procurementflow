{
  "name": "procurementflow-erp-simulator",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "typecheck": "tsc --noEmit",
    "db:init": "node ../scripts/database.mjs init",
    "db:reset": "node ../scripts/database.mjs reset"
  },
  "dependencies": {
    "@cap-js/hana": "3.2.0",
    "@cap-js/sqlite": "3.1.3",
    "@sap/cds": "10.2.2",
    "@sap/xssec": "4.16.0",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "0.41.1",
    "@cap-js/cds-types": "0.20.0",
    "@sap/cds-dk": "10.2.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ".local/erp.sqlite"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "integration": {
              "password": "demo-integration",
              "roles": [
                "Integration"
              ]
            },
            "erp-admin": {
              "password": "demo-erp-admin",
              "roles": [
                "Integration",
                "ErpAdmin"
              ]
            },
            "*": false
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}

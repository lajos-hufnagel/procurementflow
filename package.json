{
  "name": "procurementflow",
  "version": "0.1.0",
  "private": true,
  "description": "SAP CAP procurement and supplier-risk demo for KERNVADO Systems",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "db:init": "node scripts/database.mjs init",
    "db:reset": "node scripts/database.mjs reset",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json && tsc --project tsconfig.ui.json && npm run typecheck --prefix erp",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "build": "cds build --production && npm run build:erp && npm run build:ui && npm run build:deployment && node scripts/check-build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke:build && npm run test:ui",
    "smoke:build": "node scripts/smoke-build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "test:ui": "playwright test",
    "prestart": "npm run build:ui:dev",
    "predev": "npm run build:ui:dev",
    "build:ui:dev": "node scripts/build-ui.mjs --dev",
    "build:erp": "node scripts/build-erp.mjs",
    "predemo": "npm run build:ui:dev",
    "demo": "node scripts/demo.mjs",
    "erp:mode": "node scripts/erp-mode.mjs",
    "erp:db:init": "npm run db:init --prefix erp",
    "erp:db:reset": "npm run db:reset --prefix erp",
    "container:up": "docker compose up --build -d --wait",
    "container:down": "docker compose down",
    "container:check": "node scripts/smoke-containers.mjs",
    "build:deployment": "node scripts/build-deployment.mjs",
    "build:mta": "mbt build -p cf -t mta_archives --mtar procurementflow.mtar",
    "check:mta": "python3 scripts/check-mta.py",
    "postbuild:mta": "npm run check:mta",
    "check:btp-config": "node scripts/check-btp-config.mjs",
    "perf": "node scripts/performance/run.mjs",
    "preperf": "npm run build"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ".local/procurementflow.sqlite"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "buyer": {
              "password": "demo-buyer",
              "roles": [
                "Buyer"
              ]
            },
            "approver": {
              "password": "demo-approver",
              "roles": [
                "Approver"
              ]
            },
            "reader": {
              "password": "demo-reader",
              "roles": [
                "Reader"
              ]
            },
            "dual": {
              "password": "demo-dual",
              "roles": [
                "Buyer",
                "Approver"
              ]
            },
            "*": false
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana"
        }
      }
    },
    "i18n": {
      "default_language": "de",
      "fallback_bundle": ""
    },
    "fiori": {
      "bypass_draft": false
    }
  },
  "dependencies": {
    "@cap-js/hana": "3.2.0",
    "@cap-js/sqlite": "3.1.3",
    "@sap-cloud-sdk/connectivity": "4.10.0",
    "@sap-cloud-sdk/http-client": "4.10.0",
    "@sap/cds": "10.2.2",
    "@sap/xssec": "4.16.0",
    "decimal.js": "10.6.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-typescript": "7.29.7",
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/cds-typer": "0.41.1",
    "@cap-js/cds-types": "0.20.0",
    "@playwright/test": "1.65.0",
    "@sap/cds-dk": "10.2.1",
    "@sapui5/types": "1.154.0",
    "@types/node": "24.19.2",
    "@ui5/builder": "4.3.8",
    "@ui5/fs": "4.0.7",
    "babel-preset-transform-ui5": "7.11.1",
    "mbt": "1.2.52",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
